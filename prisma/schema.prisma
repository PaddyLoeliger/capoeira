generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LearningStatus {
  COMFORTABLE
  TO_LEARN
  LEARNING
  UNKNOWN
}

enum VerificationKind {
  UNVERIFIED
  KEEP_ONLY
  MEDIUM
  EXTERNAL_SOURCE
  NEEDS_VERIFICATION
}

model Song {
  id                 String             @id @default(cuid())
  title              String             @unique
  form               String?
  tradition          String?
  formStyleRaw       String?
  learningStatus     LearningStatus     @default(UNKNOWN)
  learningNote       String?
  instrumentCues     String?
  attributionNote    String?
  researchNotes      String?
  verificationRaw    String?
  verificationKind   VerificationKind   @default(UNVERIFIED)
  needsHumanReview   Boolean            @default(true)
  tags               String[]           @default([])
  occurrences        Int?
  sourceKeepNotes    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  versions           SongVersion[]
  aliases            SongAlias[]
  citations          Citation[]
  researchItems      ResearchItem[]
}

model SongVersion {
  id          String   @id @default(cuid())
  songId      String
  song        Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  lyrics      String
  contentHash String
  source      String
  createdAt   DateTime @default(now())

  @@unique([songId, contentHash])
}

model SongAlias {
  id     String @id @default(cuid())
  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  alias  String

  @@unique([songId, alias])
}

model Citation {
  id     String           @id @default(cuid())
  songId String
  song   Song             @relation(fields: [songId], references: [id], onDelete: Cascade)
  url    String
  note   String?
  kind   VerificationKind @default(EXTERNAL_SOURCE)

  @@unique([songId, url])
}

model RawKeepNote {
  id            String                 @id @default(cuid())
  fileName      String                 @unique
  title         String
  labels        Json
  textContent   String?
  listContent   Json?
  rawJson       Json
  contentHash   String
  candidates    ExtractionCandidate[]
  createdAt     DateTime               @default(now())
}

model ExtractionCandidate {
  id         String      @id @default(cuid())
  keepNoteId String
  keepNote   RawKeepNote @relation(fields: [keepNoteId], references: [id], onDelete: Cascade)
  kind       String
  payload    Json
  status     String      @default("pending")

  @@unique([keepNoteId, kind])
}

model SpreadsheetRow {
  id          String @id @default(cuid())
  sheetName   String
  rowNumber   Int
  cells       Json
  contentHash String

  @@unique([sheetName, rowNumber])
}

model ResearchItem {
  id                 String  @id @default(cuid())
  workingTitle       String
  aliases            String?
  keepContext        String?
  learningStatusRaw  String?
  sourceNotes        String?
  songId             String?
  song               Song?   @relation(fields: [songId], references: [id], onDelete: SetNull)

  @@unique([workingTitle, sourceNotes])
}

model ResearchLegend {
  status  String @id
  meaning String
}

model ArchiveDocument {
  id            String @id @default(cuid())
  fileName      String @unique
  kind          String
  sha256        String
  extractedText String?
}

model ImportRun {
  id         String   @id @default(cuid())
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  stats      Json
}

model Person {
  id   String @id @default(cuid())
  name String @unique
  notes String?
}

model Movement {
  id    String @id @default(cuid())
  name  String @unique
  notes String?
}

model HistoryNote {
  id      String @id @default(cuid())
  title   String
  body    String
}

model TrainingSession {
  id        String   @id @default(cuid())
  title     String
  notes     String?
  heldOn    DateTime?
}

model SourceRecord {
  id    String @id @default(cuid())
  title String
  url   String?
  notes String?
}
